{
  "name": "dsh-subagent-toolkit",
  "version": "0.2.1",
  "scripts": {
    "test": "node --test tests/*.test.js"
  },
  "description": "Configure subagent model routes and run pure official Pi CLI subagents in DeepSeek Harness",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leotpp/dsh-subagent-toolkit.git"
  },
  "homepage": "https://github.com/leotpp/dsh-subagent-toolkit#readme",
  "bugs": {
    "url": "https://github.com/leotpp/dsh-subagent-toolkit/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "market/index.example.json",
    "docs/*.png"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.5 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=3.18.0"
  }
}
